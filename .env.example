# Telegram Session Bot — Environment Variables
# فقط BOT_TOKEN و ADMIN_ID را پر کنید — بقیه خودکار تنظیم می‌شوند

BOT_TOKEN=your_bot_token_here
ADMIN_ID=your_telegram_id_here

# ── پایگاه داده (خودکار تنظیم می‌شود) ──────────────────────
POSTGRES_DB=smmbot
POSTGRES_USER=smm
POSTGRES_PASSWORD=change_this_strong_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Redis (خودکار) ──────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# ── اختیاری ─────────────────────────────────────────────────
# BACKUP_DIR=/app/data/backups
# SESSIONS_DIR=/app/sessions
# DATA_DIR=/app/data
# FORCE_JOIN_CHANNEL=@yourchannel
